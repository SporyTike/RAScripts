// Inazuma Eleven 2: Firestorm
// #ID = 16625

//--------------------------------------------------
// Memory Addresses

mem_PointerMapData      = 0x00038a88
mem_PointerGalleryData  = 0x0003ef60 
mem_PointerGameData     = 0x00038a98
mem_PointerGameData2    = 0x00038a8c
mem_PointerGameData3    = 0x00038a90
mem_PointerGameData4    = 0x00038a94
mem_PointerPlayerData   = 0x00038a4c
mem_PointerMatchData    = 0x00038a54
mem_PointerTeamData     = 0x00035d84

//--------------------------------------------------
// Functions

function pseudoImpossibleCondition() {
    return dword(mem_PointerPlayerData) == 0x00FFFFFF
}

function getGameState() {
    return dword(tbyte(mem_PointerGameData3) + 0x264)
}

function checkNonDebug() {
    pointerChain = tbyte(tbyte(mem_PointerGameData) + 0x08)
    return dword_be(pointerChain + 0x560 + 0x00) == 0x32313031 &&
           dword_be(pointerChain + 0x560 + 0x04) == 0x30303030
}

function getMapID() {
    return byte(tbyte(mem_PointerMapData) + 0x588 + 0x01) * 0x1000000
         + low4(tbyte(mem_PointerMapData) + 0x588 + 0x02) * 0x100000
         + low4(tbyte(mem_PointerMapData) + 0x588 + 0x03) * 0x10000
         + byte(tbyte(mem_PointerMapData) + 0x588 + 0x04) * 0x100
         + low4(tbyte(mem_PointerMapData) + 0x588 + 0x05) * 0x10
         + low4(tbyte(mem_PointerMapData) + 0x588 + 0x06) * 0x1
}

function checkMapID(mapID) {
    return any_of(array_filter(mapIDs, mapString => mapIDs[mapString][0] == mapID), mapString => getMapID() == mapString)
}

function getStoryProgress() {
    return dword(tbyte(mem_PointerGameData2) + 0x2718)
}

function getMovieFlag(movieAddressOffset, movieAddressBit) {
    return bit(movieAddressBit, tbyte(mem_PointerGalleryData) + 0x28 + movieAddressOffset)
}

function getRPGTotalTeamMembers() {
    return byte(tbyte(tbyte(mem_PointerGameData) + 0x00) + 0x38)
}

function getRPGCharacterIDInTeamSlot(slot) {
    slot = slot - 1
    return word(tbyte(tbyte(mem_PointerGameData) + 0x00) + 0x29 + (slot * 0x04))
}

function getRPGCharacterIDInPartnerSlot() {
    return word(tbyte(tbyte(mem_PointerGameData) + 0x00) + 0x3D)
}

function getChapter() {
    return byte(tbyte(mem_PointerPlayerData) + 0x4A)
}

function getPrestigePoints() {
    return dword(tbyte(mem_PointerPlayerData) + 0x14)
}

function getFriendshipPoints() {
    return dword(tbyte(mem_PointerPlayerData) + 0x18)
}

function getPlaytime() {
    return dword(tbyte(mem_PointerPlayerData) + 0x1C) / 3600
}

function getMatchType() {
    return byte(tbyte(mem_PointerGameData4) + 0x1DE)
}

function getMatchPhase() {
    return byte(tbyte(mem_PointerMatchData) + 0x7F)
}

function getMatchTime() {
    return dword(tbyte(mem_PointerMatchData) + 0x04)
}

function checkBattleIsStory(boolean) {
    if (boolean == true) {
        return byte(tbyte(mem_PointerMapData) + 0x5B30) == 0x17
    } 
    if (boolean == false) {
        return byte(tbyte(mem_PointerMapData) + 0x5B30) == 0x04
    }
}

function getTeamID(teamSlot) {
    teamSlot = teamSlot - 1
    return word(tbyte(mem_PointerMatchData) + 0x82 + (teamSlot * 0x02))
}

function getTeamGoals(teamSlot) {
    teamSlot = teamSlot - 1
    return byte(tbyte(mem_PointerMatchData) + 0x88 + teamSlot)
}

function getTeamBallPossession(teamSlot) {
    teamSlot = teamSlot - 1
    return dword(tbyte(mem_PointerGameData4) + 0x15C + (teamSlot * 0x10))
}

function getTeamSize(teamSlot) {
    teamSlot = teamSlot - 1
    code = 0
    for i in range(0, 15) {
        address = dword(tbyte(mem_PointerTeamData) + 0x81F0 + (i * 0x04) + (teamSlot * 0x40))
        code = code 
             + (address / address)
    }
    return code
}

function getCutsceneState() {
    return byte(tbyte(mem_PointerGameData3) + 0x102)
}

